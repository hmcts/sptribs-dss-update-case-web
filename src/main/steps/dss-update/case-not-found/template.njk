{% extends "common/page.njk" %}

{% block backLink %}
  <a href="/dss-update/casefinder" class="govuk-back-link">{{ back }}</a>
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">{{ heading }}</h1>

    <p class="govuk-body">{{ line1 }}</p>

    <p class="govuk-body">{{ line2 }}</p>

    <div class="govuk-button-group govuk-!-margin-top-6">
      <a href="/dss-update/casefinder" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
        {{ reEnterReference }}
      </a>
    </div>

    <p class="govuk-body">
      <a href="/contact-us" class="govuk-link">{{ contactSupport }}</a>
    </p>
  </div>
</div>
{% endblock %}
